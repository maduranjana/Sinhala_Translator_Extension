{
    "manifest_version": 3,
    "name": "Madu Sinhala Translator",
    "version": "1.2",
    "description": "Madu Sinhala Translator helps you instantly translate English words to Sinhala. Just select any word on a webpage to view its meaning in a clean, interactive popup.",
    "permissions": ["scripting", "activeTab"],
    "host_permissions": ["https://www.maduraonline.com/*"],
    "background": {
      "service_worker": "background.js"
    },
    "action": {
      "default_popup": "popup.html",
      "default_icon": {
      "16": "icon-16.png",
      "48": "icon-48.png",
      "128": "icon-128.png"
    }
    },
    "content_scripts": [
      {
        "matches": ["<all_urls>"],
        "js": ["content.js"]
      }
    ]
  }
  